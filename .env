# ===== Security =====
# Thordata Token এনক্রিপ্ট করার কী (Fernet)। তৈরি করতে:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# একবার সেট করলে আর বদলাবেন না (বদলালে সংরক্ষিত Token পড়া যাবে না)
ENCRYPTION_KEY=d2a429f510e739d522dee968f2a1f4da

# ===== Thordata (ঐচ্ছিক) =====
# বট থেকে Token সেট করলে এগুলো লাগবে না। Dashboard -> My Account থেকে পাবেন।
THORDATA_TOKEN=d2a429f510e739d522dee968f2a1f4da
THORDATA_KEY=d2a429f510e739d522dee968f2a1f4da

# 1 = Residential Proxies, 2 = Unlimited Proxy Servers
PROXY_TYPE=1
# Proxy লাইনে যে host/port দেখানো হবে (Thordata Dashboard-এর নির্দেশ অনুযায়ী মিলিয়ে নিন)
PROXY_HOST=t.thordata.online
PROXY_PORT=9999

# Account traffic_balance-এর একক। ডকুমেন্টেশন: MB। সংখ্যা ১০২৪ গুণ ভুল দেখালে KB করুন।
TRAFFIC_BALANCE_UNIT=MB

# ===== Hosting =====
# Render/Koyeb ইত্যাদি PORT নিজে দেয়। লোকাল রানে খালি রাখুন।
# PORT=8080
LOG_LEVEL=INFO
